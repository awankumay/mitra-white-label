{
  "permissions": {
    "deny": [
      "Bash(sudo *)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(wget *|bash*)",
      "Bash(wget *| bash*)",
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git reset --hard*)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Edit(~/.ssh/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.npmrc)",
      "Read(~/.npm/**)",
      "Read(~/.pypirc)",
      "Read(~/.gem/credentials)",
      "Read(~/Library/Keychains/**)",
      "Bash(php artisan db:seed*)",
      "Bash(php artisan migrate*)",
      "Bash(php artisan migrate:fresh*)",
      "Bash(php artisan migrate:refresh*)",
      "Bash(php artisan migrate:reset*)",
      "Bash(php artisan migrate:rollback*)",
      "Bash(php artisan db:wipe*)",
      "Bash(php artisan db:drop*)",
      "Bash(php artisan db:drop --force*)",
      "Bash(php artisan db:drop --force --database=*)",
      "Bash(php artisan db:drop --force --database=* --env=*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "shell|read|write|edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \".commandcode/hooks/global-guard.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "shell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \".commandcode/hooks/deny-dangerous.sh\"",
            "timeout": 5
          }
        ]
      }
    ],    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"C:/Users/LENOVO/.claude/scripts/session-save-reminder.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c \"rm -f C:/Users/LENOVO/.claude/state/.session-start C:/Users/LENOVO/.claude/state/.session-reminded 2>/dev/null\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}